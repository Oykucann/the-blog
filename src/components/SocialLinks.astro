---
import type { Author } from '../utils/posts';

interface Props {
  author: Author;
  /** "icons" shows icons only, "labels" shows icon and text. */
  variant?: 'icons' | 'labels';
}

const { author, variant = 'icons' } = Astro.props;
const { name, github, linkedin } = author.data;

const links = [
  github && { kind: 'github', href: `https://github.com/${github}`, label: 'GitHub' },
  // new URL() percent-encodes non-ASCII paths such as /in/öykü-can/.
  linkedin && { kind: 'linkedin', href: new URL(linkedin).href, label: 'LinkedIn' },
].filter(Boolean) as { kind: 'github' | 'linkedin'; href: string; label: string }[];
---

{
  links.length > 0 && (
    <ul class={`social ${variant}`}>
      {links.map((l) => (
        <li>
          <a href={l.href} rel="me noopener" aria-label={`${name} on ${l.label}`}>
            {l.kind === 'github' ? (
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                />
              </svg>
            ) : (
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0zM4.75 13.63H2.38V6h2.37v7.63zM3.56 4.96a1.38 1.38 0 110-2.75 1.38 1.38 0 010 2.75zm10.07 8.67h-2.37V9.92c0-.89-.02-2.02-1.23-2.02-1.23 0-1.42.96-1.42 1.96v3.77H6.24V6h2.27v1.04h.03c.32-.6 1.09-1.23 2.25-1.23 2.4 0 2.84 1.58 2.84 3.64v4.18z"
                />
              </svg>
            )}
            {variant === 'labels' && <span>{l.label}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .icons a {
    padding: 4px;
    margin: -4px;
  }

  a:hover {
    color: var(--accent);
  }

  svg {
    flex: none;
  }
</style>
