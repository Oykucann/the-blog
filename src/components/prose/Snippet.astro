---
import { Code } from 'astro:components';
import type { ShikiTransformer } from 'shiki';
import CodeBlock from './CodeBlock.astro';
import { SITE } from '../../utils/site';

interface Props {
  /** Path inside the repository's code/ folder, e.g. "my-post/affected.ts". */
  file: string;
  /** A single line ("12") or a range ("12-30"). Omit to show the whole file. */
  lines?: string;
  /** Override the language guessed from the file extension. */
  lang?: string;
  /** Override the title shown above the code. Defaults to the file path. */
  title?: string;
}

// Every file under code/ is read as text at build time. Nothing in code/ is
// executed or type-checked by the blog.
const files = import.meta.glob<string>('/code/**/*', { query: '?raw', import: 'default', eager: true });

const { file, lines, lang, title } = Astro.props;
const key = `/code/${file.replace(/^\/+/, '').replace(/^code\//, '')}`;
const source = files[key];

if (source === undefined) {
  throw new Error(`<Snippet file="${file}">: there is no file at ${key.slice(1)}. Paths start inside the code/ folder.`);
}

const all = source.replace(/\r\n/g, '\n').replace(/\n$/, '').split('\n');

let start = 1;
let end = all.length;
if (lines) {
  const match = /^(\d+)(?:\s*-\s*(\d+))?$/.exec(lines.trim());
  if (!match) {
    throw new Error(`<Snippet file="${file}" lines="${lines}">: use a line number like "12" or a range like "12-30".`);
  }
  start = Number(match[1]);
  end = Number(match[2] ?? match[1]);
  if (start < 1 || end < start || end > all.length) {
    throw new Error(`<Snippet file="${file}" lines="${lines}">: the file has ${all.length} lines.`);
  }
}

// Remove the indentation shared by every selected line.
const selected = all.slice(start - 1, end);
const indent = Math.min(...selected.filter((l) => l.trim()).map((l) => l.match(/^[ \t]*/)![0].length));
const code = selected.map((l) => l.slice(Number.isFinite(indent) ? indent : 0)).join('\n');

const LANGS: Record<string, string> = {
  ts: 'ts', tsx: 'tsx', js: 'js', jsx: 'jsx', mjs: 'js', cjs: 'js',
  py: 'python', go: 'go', rs: 'rust', java: 'java', kt: 'kotlin', rb: 'ruby', php: 'php',
  cs: 'csharp', c: 'c', h: 'c', cpp: 'cpp', swift: 'swift',
  sh: 'bash', bash: 'bash', zsh: 'bash', ps1: 'powershell',
  yml: 'yaml', yaml: 'yaml', json: 'json', toml: 'toml', ini: 'ini', xml: 'xml',
  sql: 'sql', tf: 'hcl', hcl: 'hcl', md: 'markdown', html: 'html', css: 'css',
};
const name = key.split('/').pop()!;
const ext = name.includes('.') ? name.split('.').pop()!.toLowerCase() : '';
const language = lang ?? (name === 'Dockerfile' ? 'dockerfile' : name === 'Makefile' ? 'makefile' : LANGS[ext] ?? 'plaintext');

// Show the file's real line numbers so they match the GitHub link.
const lineNumbers: ShikiTransformer = {
  line(node, line) {
    node.properties['data-line'] = String(start + line - 1);
  },
};

const range = lines ? (start === end ? `#L${start}` : `#L${start}-L${end}`) : '';
const href = `${SITE.repo}/blob/main${key}${range}`;
const label = title ?? `${key.slice('/code/'.length)}${lines ? ` · ${start === end ? `line ${start}` : `lines ${start}–${end}`}` : ''}`;
---

<div class="snippet">
  <CodeBlock title={label} href={href} linkLabel="View full file">
    <Code
      code={code}
      lang={language as any}
      themes={{ light: 'github-light', dark: 'github-dark' }}
      defaultColor={false}
      transformers={[lineNumbers]}
    />
  </CodeBlock>
</div>

<style>
  .snippet :global(pre code) {
    counter-reset: none;
  }

  .snippet :global(.line::before) {
    content: attr(data-line);
    display: inline-block;
    width: 3ch;
    margin-right: 1.25ch;
    text-align: right;
    color: var(--muted);
    opacity: 0.6;
    user-select: none;
  }
</style>
