---
interface Props {
  /** Shown in the title bar, e.g. "zsh" or "~/the-blog". */
  title?: string;
}

const { title = 'Terminal' } = Astro.props;
---

<div class="terminal">
  <div class="bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
  </div>
  <slot />
</div>

<style>
  .terminal {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--term-bg);
    border: 1px solid color-mix(in oklab, var(--term-bg) 80%, #fff);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: #8b919e;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3f4b;
  }

  /* Terminals stay dark in both modes, so always use the dark Shiki colours. */
  .terminal :global(pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
  }

  .terminal :global(pre),
  .terminal :global(pre span) {
    color: var(--shiki-dark, var(--term-ink)) !important;
  }
</style>
