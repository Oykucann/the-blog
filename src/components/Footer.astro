---
import { SITE, url } from '../utils/site';
---

<footer class="site-footer">
  <div class="container inner">
    <p>
      Written together, published from <a href={SITE.repo}>GitHub</a>.
      Text <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, code
      <a href={`${SITE.repo}/blob/main/LICENSE`}>MIT</a>.
    </p>
    <nav aria-label="Footer">
      <a href={url('rss.xml')}>RSS</a>
      <a href={url('authors/')}>Authors</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--ink);
  }
</style>
