---
import { render } from 'astro:content';
import PostLayout from '../../layouts/Post.astro';
import * as prose from '../../components/prose';
import { getDrafts, type Post } from '../../utils/posts';

// Drafts are built on the published site too, at unlisted /drafts/<id>/ URLs,
// so teammates can read them and the build catches their errors early.
export async function getStaticPaths() {
  const drafts = await getDrafts();
  return drafts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post}>
  <Content components={prose} />
</PostLayout>
