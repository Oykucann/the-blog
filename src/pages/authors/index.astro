---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorMark from '../../components/AuthorMark.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { url } from '../../utils/site';

const authors = (await getCollection('authors')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));
---

<Base title="Authors" description="The people who write here.">
  <div class="container page">
    <header>
      <p class="eyebrow">Authors</p>
      <h1>The people who write here</h1>
    </header>
    <ul class="grid">
      {authors.map((a) => (
        <li>
          <AuthorMark author={a} size={44} />
          <div class="who">
            <h2><a href={url(`authors/${a.id}/`)}>{a.data.name}</a></h2>
            {a.data.title && <p class="title">{a.data.title}</p>}
          </div>
          <SocialLinks author={a} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page {
    max-width: calc(46rem + 32px);
    padding-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  header p {
    margin: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 600;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .who {
    flex: 1;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
