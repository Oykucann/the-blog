---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AuthorMark from '../../components/AuthorMark.astro';
import PostList from '../../components/PostList.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { getPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { id: author.id }, props: { author } }));
}

interface Props {
  author: CollectionEntry<'authors'>;
}

const { author } = Astro.props;
const { name, title, bio } = author.data;
const posts = (await getPosts()).filter((p) => p.data.authors.some((a) => a.author.id === author.id));
---

<Base title={name} description={bio ?? `Posts by ${name}.`}>
  <div class="container page">
    <header>
      <AuthorMark author={author} size={64} />
      <div class="text">
        <h1>{name}</h1>
        {title && <p class="title">{title}</p>}
        {bio && <p class="bio">{bio}</p>}
        <div class="links"><SocialLinks author={author} variant="labels" /></div>
      </div>
    </header>

    <section aria-labelledby="posts">
      <h2 id="posts" class="eyebrow">Worked on</h2>
      {posts.length > 0 ? <PostList posts={posts} /> : <p>Nothing published yet.</p>}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: calc(46rem + 32px);
    padding-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .text p {
    margin: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 600;
  }

  .title {
    color: var(--muted);
  }

  .bio {
    font-family: var(--serif);
    max-width: 58ch;
    margin-top: 0.4rem !important;
  }

  .links {
    margin-top: 0.5rem;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-weight: 400;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
  }
</style>
